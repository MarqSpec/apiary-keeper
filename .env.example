# Copy to .env (git-ignored) and fill in. Names only here - never a real value.
# The local postgres service's password; compose builds ConnectionStrings__ApiaryCopilot from it.
POSTGRES_PASSWORD=
# The local MinIO media bucket's root user and password (8 or more characters); compose gives them to the api as its
# bucket credentials (Media__AccessKeyId, Media__SecretAccessKey).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
