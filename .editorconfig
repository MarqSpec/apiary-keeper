root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

# File-scoped namespaces are required - enforced as a build
# error via EnforceCodeStyleInBuild in Directory.Build.props.
csharp_style_namespace_declarations = file_scoped:error

# Classes are sealed by default unless designed for inheritance.
dotnet_diagnostic.CA1852.severity = warning

[src/tests/**/*.cs]
# Test names are {Function}_Should{Result}_When{Condition} (CONVENTIONS.md §8).
dotnet_diagnostic.CA1707.severity = none

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

# EF Core-generated migrations are generated code: suppress style/quality analyzers on them
# (block namespaces, constant array args, etc.). Hand-written entities/DbContext still meet the
# full standards.
[**/Migrations/*.cs]
generated_code = true
